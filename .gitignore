# CDS credentials - NEVER COMMIT
.cdsapirc

# the publish watcher's state file - it belongs to the machine, not the repo
data/.publish_fingerprint

# raw / bulky data (re-fetchable with the scripts in this repo)
data/*.grib
data/*.nc
data/arco_chunks/
data/seas5_*_snow.npz
*.grib

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# local preview scratch
site_preview.png

# editors / os
.DS_Store
*.swp

# transient logs and scratch
data/*.log
_*.log
_*.sh
_*.py

# model fetch working dir (large GRIBs, re-fetchable)
data/models/
# local site preview screenshots
preview/

# transient fetch logs / job dumps
data/probe/

# local logs and previews
*.log
preview_*.png

# transient job ids and NFS leftovers
data/*_new.txt
data/jma_snow_job.txt
.nfs*

# the GitHub token: mode 600, never committed
data/.github_token

# the daily refresh marker (the machine, not the repo)
data/.daily_fetch_*

# the polar-cap working data: re-fetchable with the scripts in this repo
data/era5_polarcap_profiles.npz
data/polar_cap_recent.npz
data/polar_model_z.json
data/polar_aifs.json
data/polar_gefs_jobs.json
data/polar_ec46_jobs.json
data/polar_ec46_z.json
data/_aifs.lock
data/_aifs_step.grib2

# in-flight downloads (the fetchers write these while the queue runs)
*.part
data/_gefs_*.grib2
data/_polz_*.grib
